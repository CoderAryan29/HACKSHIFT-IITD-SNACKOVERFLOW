# Required: Google Gemini API key.
GOOGLE_API_KEY=

# Required: Supabase/PostgreSQL connection string.
DATABASE_URL=

# Required for Firebase Admin ID-token verification.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: Supabase HTTP configuration for shared backend integrations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Gemini model override.
GEMINI_MODEL=gemini-3.8-flash

# Optional: LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kisansetu-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional: override the existing local Hugging Face cache assets.
# KISANSETU_TFLITE_MODEL_PATH=
# KISANSETU_TFLITE_LABELS_PATH=

# Optional: comma-separated browser origins allowed by the unified API.
KISANSETU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
